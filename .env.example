# 夜街 · 开发环境示例配置（复制为 .env 后填写；不要提交真实凭据）
# Go 服务不自动读取 .env，请用 shell / Docker Compose / 进程环境注入。
YJ_ENV=dev
YJ_HTTP_ADDR=127.0.0.1:18080
YJ_LOG_LEVEL=info

# PostgreSQL（唯一生产事实来源）
YJ_DATABASE_URL=postgres://yejie:yejie_dev@127.0.0.1:5432/yejie?sslmode=disable
YJ_DB_MAX_OPEN_CONNS=20
YJ_DB_MAX_IDLE_CONNS=5
YJ_DB_CONN_MAX_LIFETIME=30m

# Redis（会话 / 缓存 / 限流 / 调度协调，可重建）
YJ_REDIS_ADDR=127.0.0.1:6380
YJ_REDIS_PASSWORD=
YJ_REDIS_DB=0

# Nuxt 前端
YJ_WEB_ORIGIN=http://127.0.0.1:3000
YJ_API_ORIGIN=http://127.0.0.1:18080
YJ_ALLOWED_ORIGINS=http://127.0.0.1:3000
YJ_TRUSTED_PROXIES=127.0.0.1/32

# 会话（生产必须 CookieSecure=true）
YJ_COOKIE_SECURE=false
YJ_SESSION_IDLE_TTL=30m
YJ_SESSION_ABSOLUTE_TTL=168h

# S3 兼容测试桶（M1 起使用；本地为 versitygw，生产为 Cloudflare R2 + Backblaze B2 私人桶）
# 浏览器分片直传要求桶允许跨域 PUT 并暴露 ETag：
#   Access-Control-Allow-Origin / Allow-Methods: PUT / Expose-Headers: ETag
# versitygw 默认已满足；生产 R2/B2 需在桶 CORS 规则中显式配置 ExposeHeader ETag。
# S3_PUBLIC_ENDPOINT 是签发给浏览器的地址（生产应为 CDN 域名），
# S3_ENDPOINT 是应用内部访问地址；两者不同时会用各自的 host 分别签名。
YJ_S3_ENDPOINT=http://127.0.0.1:9100
YJ_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9100
YJ_S3_BUCKET=yejie-dev
YJ_S3_REGION=us-east-1
YJ_S3_ACCESS_KEY=yejie_dev
YJ_S3_SECRET_KEY=yejie_dev_secret

# Worker / FFmpeg（本地工具位于 .tools/ffmpeg，已加入 .gitignore）
YJ_FFMPEG_PATH=D:/project/voidxotv/.tools/ffmpeg/ffmpeg.exe
YJ_FFPROBE_PATH=D:/project/voidxotv/.tools/ffmpeg/ffprobe.exe
YJ_WORKER_ID=dev-worker-1
YJ_WORKER_TEMP_DIR=D:/project/voidxotv/data/transcode-tmp
YJ_WORKER_LEASE_TTL=60s
YJ_WORKER_HEARTBEAT=20s
YJ_WORKER_IDLE_INTERVAL=5s
YJ_TRANSCODE_TIMEOUT=30m
YJ_MAX_UPLOAD_MB=2048
# 短视频阈值（毫秒）：<= 阈值走 720p MP4，> 阈值走 480p/720p fMP4 HLS。默认 180000（3 分钟）
YJ_SHORT_VIDEO_MAX_MS=180000

# Nuxt 服务端访问 Go API 的内部地址
API_ORIGIN=http://127.0.0.1:18080

# M3 页面交付与 SEO（YJ_DELIVERY_TOKEN 为开发默认值，生产必须替换）
YJ_SITE_URL=http://127.0.0.1:13000
# Nuxt 运行时覆盖（canonical / OG / sitemap）；未设置时由 YJ_SITE_URL 派生
NUXT_PUBLIC_SITE_URL=http://127.0.0.1:13000
YJ_DELIVERY_TOKEN=dev-internal-token
YJ_DELIVERY_NUXT_ORIGIN=http://127.0.0.1:13000
YJ_DELIVERY_DEBOUNCE=3s
YJ_DELIVERY_HOME_DEBOUNCE=5s
YJ_DELIVERY_LEASE_TTL=60s
YJ_DELIVERY_IDLE_INTERVAL=2s
YJ_DELIVERY_MAX_ATTEMPTS=5
# 生产 CDN 精确失效（留空时 Delivery 只记录日志，不影响页面发布）
YJ_CDN_ZONE_ID=
YJ_CDN_API_TOKEN=

# M4 管理后台与运营（后台账号由 `go run ./cmd/seed` 幂等创建）
# 生产必须替换为强口令；开发占位值仅用于本地验收。
YJ_ADMIN_BOOTSTRAP_PASSWORD=dev-admin-password
# 统计聚合周期（规范 §7.6：每 5 分钟）与远程导入 Worker 轮询间隔
YJ_STATS_INTERVAL=5m
YJ_IMPORTS_INTERVAL=5s
# SSRF 允许列表：默认拒绝所有环回/内网/元数据地址；受信任内网需显式登记主机名
YJ_TRUSTED_IMPORT_HOSTS=

# 邮件通道（§11.7：自建 SMTP，经 Outbox 异步投递）
# YJ_SMTP_HOST 留空 = 未配置：邮件事件进入死信并记录原因，找回密码不可用。
YJ_SMTP_HOST=
YJ_SMTP_PORT=587
YJ_SMTP_USERNAME=
YJ_SMTP_PASSWORD=
YJ_SMTP_FROM=no-reply@example.com

# M5 优化
# HEVC 作为可选流（默认关闭，H.264 始终保留回退）
YJ_TRANSCODE_HEVC=false
# 推荐排序：rule（可解释规则，默认）或 newest（按时间回退）
YJ_FEED_RANKING=rule
YJ_FEED_CANDIDATE_DAYS=30
# 生产使用 CDN 公共媒体地址时设为 true，详情页缓存恢复 3600s；
# 开发期是 30 分钟签名 URL，必须保持 false（300s）。
YJ_PUBLIC_MEDIA=false
